# Helpers: logging
# =====================================================================================


_LOG_LEVELS: Dict[str, int] = {"DEBUG": 10, "INFO": 20, "WARNING": 30, "ERROR": 40}


def _log_level_value(level: str) -> int:
    return _LOG_LEVELS.get((level or "").upper().strip(), 20)


def log(level: str, message: str) -> None:
    if not LOG_FILE:
        return
    if _log_level_value(level) < _log_level_value(LOG_LEVEL):
        return
    try:
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        pid = os.getpid()
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] [{level.upper():7}] [PID:{pid}] {message}\n")
    except Exception:
        # Swallow logging errors; they are never worth breaking playback.
        pass


def monotonic_ms() -> float:
    return time.monotonic() * 1000.0


def budget_exhausted(start_ms: float) -> bool:
    if DECISION_BUDGET_MS <= 0:
        return True
    return (monotonic_ms() - start_ms) >= DECISION_BUDGET_MS


def remaining_decision_budget_s() -> Optional[float]:
    if _ACTIVE_DECISION_START_MS is None:
        return None
    if DECISION_BUDGET_MS <= 0:
        return 0.0
    remaining_ms = DECISION_BUDGET_MS - (monotonic_ms() - _ACTIVE_DECISION_START_MS)
    return max(0.0, remaining_ms / 1000.0)


def active_decision_budget_exhausted() -> bool:
    remaining = remaining_decision_budget_s()
    return remaining is not None and remaining <= 0


def _empty_telemetry() -> dict:
    return {
        "version": 1,
        "outcomes": {},
        "latency_ms": {"count": 0, "sum": 0.0, "max": 0.0, "samples": []},
        "version_index": {},
    }


def _increment_counter(root: dict, section: str, key: str, amount: int = 1) -> None:
    bucket = root.setdefault(section, {})
    row = bucket.setdefault(key, {"count": 0})
    row["count"] = int(row.get("count", 0)) + amount


def _record_latency(bucket: dict, elapsed_ms: float) -> None:
    value = round(max(0.0, float(elapsed_ms)), 3)
    bucket["count"] = int(bucket.get("count", 0)) + 1
    bucket["sum"] = round(float(bucket.get("sum", 0.0)) + value, 3)
    bucket["max"] = round(max(float(bucket.get("max", 0.0)), value), 3)
    samples = bucket.setdefault("samples", [])
    if isinstance(samples, list):
        samples.append(value)
        del samples[:-256]
        ordered = sorted(float(v) for v in samples)
        p50_idx = max(0, min(len(ordered) - 1, int((len(ordered) - 1) * 0.50 + 0.999999)))
        p95_idx = max(0, min(len(ordered) - 1, int((len(ordered) - 1) * 0.95 + 0.999999)))
        bucket["p50"] = round(ordered[p50_idx], 3)
        bucket["p95"] = round(ordered[p95_idx], 3)


def record_telemetry(
    outcome: str,
    *,
    elapsed_ms: Optional[float] = None,
    index_status: str = "",
) -> None:
    if not (TELEMETRY_ENABLED and TELEMETRY_FILE):
        return
    try:
        os.makedirs(os.path.dirname(TELEMETRY_FILE) or ".", exist_ok=True)
        try:
            with open(TELEMETRY_FILE, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            if not isinstance(data, dict) or data.get("version") != 1:
                data = _empty_telemetry()
        except Exception:
            data = _empty_telemetry()

        _increment_counter(data, "outcomes", re.sub(r"[^a-z0-9_.-]+", "_", str(outcome).lower()).strip("_") or "unknown")
        if index_status:
            _increment_counter(data, "version_index", re.sub(r"[^a-z0-9_.-]+", "_", index_status.lower()).strip("_") or "unknown")
        if elapsed_ms is not None:
            _record_latency(data.setdefault("latency_ms", {"count": 0, "sum": 0.0, "max": 0.0, "samples": []}), elapsed_ms)

        tmp = TELEMETRY_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, sort_keys=True)
        os.replace(tmp, TELEMETRY_FILE)
    except Exception:
        pass


def block_4k_transcode(reason: str, decision_start_ms: float) -> None:
    log("ERROR", f"Policy: blocking 4K transcode ({reason}); verified lower Plex Version is required")
    record_telemetry(
        "blocked_4k_transcode",
        elapsed_ms=monotonic_ms() - decision_start_ms,
        index_status=VERSION_INDEX_LAST_STATUS,
    )
    sys.exit(1)


def source_actual_height_unproven(input_file: str, current: Optional["MediaInfo"]) -> bool:
    """Return true when neither Plex metadata nor an explicit filename token proves source height."""
    if current is not None and current.height is not None:
        return False
    return file_path_height_hint(input_file) is None


def block_unknown_actual_height(input_file: str, decision_start_ms: float, reason: str) -> None:
    log(
        "ERROR",
        f"Policy: blocking transcode with unknown actual source height ({reason}); file={os.path.basename(input_file)}",
    )
    record_telemetry(
        "unknown_actual_height_blocked",
        elapsed_ms=monotonic_ms() - decision_start_ms,
        index_status=VERSION_INDEX_LAST_STATUS,
    )
    sys.exit(1)


# =====================================================================================
# Helpers: Plex HTTP
# =====================================================================================


def effective_plex_token() -> str:
    """Return the configured token, token-file token, or best-effort env token."""
    if PLEX_TOKEN_FILE.strip():
        try:
            return _read_plex_token_file(PLEX_TOKEN_FILE)
        except RuntimeError as exc:
            log("ERROR", f"Plex token file rejected: {exc}")
            return ""
    if PLEX_TOKEN.strip():
        return PLEX_TOKEN.strip()
    for env_key in PLEX_TOKEN_ENV_VARS:
        v = (os.environ.get(env_key) or "").strip()
        if v:
            return v
    return ""


def _join_url(base: str, path: str) -> str:
    base = (base or "").rstrip("/")
    path = (path or "").strip()
    if not path.startswith("/"):
        path = "/" + path
    return base + path


def plex_get_json(path: str, params: Dict[str, str]) -> Optional[dict]:
    """GET a Plex endpoint and parse JSON.

    Returns a dict on success, or None on error.
    """
    token = effective_plex_token()
    if not token:
        log("ERROR", "PLEX_TOKEN is not configured and no X_PLEX_TOKEN env var was found.")
        return None
    remaining_budget_s = remaining_decision_budget_s()
    if remaining_budget_s is not None and remaining_budget_s <= 0:
        log("DEBUG", f"Decision budget exhausted before Plex API request path={path}")
        return None
    timeout_s = PLEX_HTTP_TIMEOUT_S
    if remaining_budget_s is not None:
        timeout_s = min(PLEX_HTTP_TIMEOUT_S, max(remaining_budget_s, 0.001))

    q = dict(params or {})
    url = _join_url(PLEX_URL, path)
    if q:
        url = url + ("?" + urllib.parse.urlencode(q))

    req = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "X-Plex-Token": token},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_s) as resp:
            raw = resp.read()
        return json.loads(raw.decode("utf-8", errors="replace"))
    except Exception as e:
        log("DEBUG", f"Plex API error path={path} err={e}")
        return None


# =====================================================================================
# Helpers: metadata parsing (height / dynamic range / stream indices)
# =====================================================================================


def safe_int(v) -> Optional[int]:
    try:
        if v is None:
            return None
        if isinstance(v, bool):
            return None
        return int(str(v).strip())
    except Exception:
        return None


def parse_resolution_hint(v) -> Optional[int]:
    """Parse Plex resolution strings like '4k', '1080', 'sd', etc."""
    if v is None:
        return None
    s = str(v).strip().lower()
    if not s:
        return None
    if s == "4k":
        return 2160
    if s == "1080":
        return 1080
    if s == "720":
        return 720
    if s == "sd":
        return 480
    if s.isdigit():
        n = int(s)
        return n if n > 0 else None
    return None


def file_path_height_hint(file_path: str) -> Optional[int]:
    """Infer obvious resolution tokens from a media path without Plex metadata."""
    name = os.path.basename(str(file_path or "")).lower()
    if not name:
        return None
    if re.search(r"(?<![a-z0-9])(4k|uhd)(?![a-z0-9])", name):
        return 2160
    match = re.search(r"(?<!\d)(4320|2160|1440|1080|720|576|480|360)p?(?!\d)", name)
    if match:
        return int(match.group(1))
    return None


def file_path_looks_remux(file_path: str) -> bool:
    name = os.path.basename(str(file_path or "")).lower()
    return bool(re.search(r"(?<![a-z0-9])remux(?![a-z0-9])", name))


def file_path_looks_4k(file_path: str) -> bool:
    height = file_path_height_hint(file_path)
    return is_protected_height(height)


def media_height(media: dict) -> Optional[int]:
    for k in ("height", "videoHeight"):
        h = safe_int(media.get(k))
        if h:
            return h
    for k in ("videoResolution", "resolution"):
        h = parse_resolution_hint(media.get(k))
        if h:
            return h
    return None


def media_bitrate_kbps(media: dict) -> Optional[int]:
    for k in ("bitrate", "videoBitrate", "videoBitrateKbps"):
        value = safe_int(media.get(k))
        if value:
            return value
    try:
        for part in _as_list(media.get("Part")):
            value = safe_int(part.get("bitrate"))
            if value:
                return value
    except Exception:
        pass
    return None


def classify_dynamic_range(dr: str) -> str:
    s = (dr or "").upper().strip()
    if not s or s in ("UNKNOWN", "NONE"):
        return "UNKNOWN"
    if "SDR" in s:
        return "SDR"
    if "DOVI" in s or "DOLBY" in s or "VISION" in s or s == "DV":
        return "DOLBY VISION"
    if "HDR" in s or "HLG" in s:
        return "HDR"
    # Any other non-empty value is treated as "not SDR".
    return "HDR"


def dynamic_range_from_file_name(file_path: str) -> str:
    """Infer common HDR/SDR tags from version filenames when Plex metadata is thin."""
    base = os.path.basename(str(file_path or ""))
    normalized = re.sub(r"[^A-Z0-9]+", " ", base.upper()).strip()
    if not normalized:
        return "UNKNOWN"

    tokens = set(normalized.split())
    if "DOLBY VISION" in normalized or {"DOLBY", "VISION"}.issubset(tokens) or "DOVI" in tokens or "DV" in tokens:
        return "DOLBY VISION"
    if any(t in tokens for t in ("HDR", "HDR10", "HDR10PLUS", "HLG")):
        return "HDR"
    if "SDR" in tokens:
        return "SDR"
    return "UNKNOWN"


_EDITION_TOKEN_RE = re.compile(r"\{edition-([^{}]+)\}", re.IGNORECASE)


def normalize_edition_key(value: object) -> str:
    if value is None:
        return ""
    return re.sub(r"\s+", " ", str(value)).strip().casefold()


def edition_key_from_file_name(file_path: str) -> str:
    match = _EDITION_TOKEN_RE.search(file_path or "")
    if not match:
        return ""
    return normalize_edition_key(match.group(1))


def media_edition_key(media: dict) -> str:
    """Return a conservative Plex Edition key for a media version."""
    for key in ("editionTitle", "edition", "editionName", "editionDisplayTitle"):
        normalized = normalize_edition_key(media.get(key))
        if normalized:
            return normalized
    parts = media.get("Part") or []
    if isinstance(parts, dict):
        parts = [parts]
    for part in parts:
        normalized = edition_key_from_file_name(str(part.get("file") or ""))
        if normalized:
            return normalized
    return ""


def media_dynamic_range(media: dict) -> str:
    """Best-effort dynamic range detection.

    Mirrors Downshiftarr.py's approach as closely as possible, but using raw JSON.
    """
    for k in ("videoDynamicRange", "dynamicRange", "videoDynamicRangeType"):
        v = media.get(k)
        if v:
            return str(v).upper().strip()

    # Stream inspection fallback requires full metadata; locator rows may be thin.
    try:
        parts = media.get("Part") or []
        if isinstance(parts, dict):
            parts = [parts]
        for part in parts:
            streams = part.get("Stream") or []
            if isinstance(streams, dict):
                streams = [streams]
            for st in streams:
                if safe_int(st.get("streamType")) != 1:
                    continue

                # Dolby Vision flags
                for a in ("DOVIPresent", "doviPresent", "dolbyVision"):
                    v = st.get(a)
                    if str(v).lower() in ("1", "true", "yes"):
                        return "DOLBY VISION"

                # HDR hints
                for a in ("hdr", "colorSpace", "colorTransfer", "colorPrimaries"):
                    v = st.get(a)
                    if v and any(k in str(v).upper() for k in ("HDR", "DOVI", "DV", "DOLBY", "HLG")):
                        return "HDR"
    except Exception:
        pass

    return "UNKNOWN"


def media_audio_risk(media: dict) -> int:
    """Lower is better. Prefer audio Plex clients commonly direct-play."""
    risk = 0
    try:
        parts = media.get("Part") or []
        if isinstance(parts, dict):
            parts = [parts]
        for part in parts:
            streams = part.get("Stream") or []
            if isinstance(streams, dict):
                streams = [streams]
            for st in streams:
                if safe_int(st.get("streamType")) != 2:
                    continue
                codec = str(st.get("codec") or st.get("audioCodec") or "").lower()
                channels = safe_int(st.get("channels")) or 0
                if codec in {"truehd", "dts", "dca", "dtsma", "flac"}:
                    risk += 4
                elif codec in {"eac3", "ac3"}:
                    risk += 1
                elif codec and codec not in {"aac", "mp3", "opus"}:
                    risk += 2
                if channels > 6:
                    risk += 2
                elif channels > 2:
                    risk += 1
    except Exception:
        return 3
    return risk


def media_subtitle_risk(media: dict) -> int:
    """Lower is better. Avoid subtitle forms that often force burn-in."""
    risk = 0
    try:
        parts = media.get("Part") or []
        if isinstance(parts, dict):
            parts = [parts]
        for part in parts:
            streams = part.get("Stream") or []
            if isinstance(streams, dict):
                streams = [streams]
            for st in streams:
                if safe_int(st.get("streamType")) != 3:
                    continue
                codec = str(st.get("codec") or "").lower()
                forced = str(st.get("forced") or "").lower() in {"1", "true", "yes"}
                if codec in {"pgs", "vobsub", "dvd_subtitle"}:
                    risk += 3
                if forced:
                    risk += 1
    except Exception:
        return 2
    return risk


def part_max_stream_index(media: dict) -> Optional[int]:
    """Return the maximum stream index found in the first Part of this Media."""
    try:
        parts = media.get("Part") or []
        if isinstance(parts, dict):
            parts = [parts]
        if not parts:
            return None
        part = parts[0]
        streams = part.get("Stream") or []
        if isinstance(streams, dict):
            streams = [streams]
        if not streams:
            return None

        idxs: List[int] = []
        for st in streams:
            i = safe_int(st.get("index"))
            if i is not None:
                idxs.append(i)

        if idxs:
            return max(idxs)

        # If Plex didn't give stream indexes, fall back to count-1.
        return len(streams) - 1
    except Exception:
        return None


# =====================================================================================
# Helpers: argument parsing
# =====================================================================================


def looks_like_video_path(p: str) -> bool:
    if not p:
        return False
    s = p.strip().lower()
    return any(s.endswith(ext) for ext in VIDEO_EXTENSIONS)


def is_streaming_transcode(args: Sequence[str]) -> bool:
    """Heuristic to avoid messing with non-streaming transcoder jobs.

    Streaming transcodes almost always output DASH or HLS segments.
    """
    # Quick keyword checks first.
    joined = " ".join(args).lower()
    if any(k in joined for k in ("-dash_segment_type", "-seg_duration", "-segment_list", "-segment_time", "seglist")):
        return True

    # Check explicit output format.
    for i, a in enumerate(args):
        if a == "-f" and i + 1 < len(args):
            fmt = (args[i + 1] or "").strip().lower()
            if fmt in STREAMING_OUTPUT_FORMATS:
                return True
    return False


def find_primary_input(args: Sequence[str]) -> Tuple[Optional[str], int]:
    """Return (input_path, index_in_args) where index points to the value after -i."""
    best_path: Optional[str] = None
    best_idx = -1

    for i, a in enumerate(args):
        if a != "-i" or i + 1 >= len(args):
            continue
        v = args[i + 1]
        if looks_like_video_path(v):
            best_path, best_idx = v, i + 1

    return best_path, best_idx


def video_codec_is_copy(args: Sequence[str], input_value_index: int) -> bool:
    """Detect audio-only transcodes / remuxing.

    Plex uses ffmpeg-style ordering: options before -i apply to input; after -i apply to outputs.
    So we only check for copy *after* the main input.
    """
    if input_value_index < 0:
        return False
    for i in range(input_value_index + 1, len(args) - 1):
        a = args[i]
        nxt = args[i + 1]
        if a in ("-c:v", "-vcodec") and nxt == "copy":
            return True
        if a == "-codec:0" and nxt == "copy":
            return True
    return False


_STREAM_REF_RE = re.compile(r"(?<!\d)0:(\d+)")


def required_max_input_stream_index(args: Sequence[str]) -> Optional[int]:
    """Parse the transcoder args to find the highest referenced input stream index (0:<n>)."""
    max_idx: Optional[int] = None
    for a in args:
        for m in _STREAM_REF_RE.finditer(a):
            n = safe_int(m.group(1))
            if n is None:
                continue
            if max_idx is None or n > max_idx:
                max_idx = n
    return max_idx


def args_indicate_hdr_tonemap(args: Sequence[str]) -> bool:
    """Heuristic: do the args contain HDR->SDR tone-mapping filters?

    This is intentionally simple and fast: we just search for well-known substrings
    Plex includes when it is trying to tonemap HDR.

    This is *not* used to rewrite anything; it's only used as a "nudge" when
    Plex metadata doesn't expose HDR/DV cleanly.
    """
    if not TREAT_TONEMAP_ARGS_AS_HDR:
        return False
    blob = " ".join(args).lower()
    return any(k in blob for k in ("tonemap", "libplacebo", "procamp"))


# =====================================================================================
# Cache
# =====================================================================================


@dataclass
class CacheEntry:
    ts: float
    rating_key: str
    fallback_file: str
    fallback_height: Optional[int]
    fallback_dr: str
    fallback_max_stream_index: Optional[int]


def _load_cache() -> Dict[str, CacheEntry]:
    if not (ENABLE_CACHE and CACHE_FILE):
        return {}
    try:
        if MAX_CACHE_BYTES > 0 and os.path.exists(CACHE_FILE) and os.path.getsize(CACHE_FILE) > MAX_CACHE_BYTES:
            record_telemetry("cache_oversized")
            return {}
        with open(CACHE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        entries = {}
        raw_entries = (data or {}).get("entries", {})
        now = time.time()
        for k, v in raw_entries.items():
            try:
                ts = float(v.get("ts", 0))
            except (AttributeError, TypeError, ValueError):
                log("DEBUG", f"Ignoring invalid cache entry key={k!r}")
            else:
                if ts <= 0 or (now - ts) > CACHE_TTL_S:
                    continue
                entries[k] = CacheEntry(
                    ts=ts,
                    rating_key=str(v.get("rating_key", "")),
                    fallback_file=str(v.get("fallback_file", "")),
                    fallback_height=safe_int(v.get("fallback_height")),
                    fallback_dr=str(v.get("fallback_dr", "UNKNOWN")),
                    fallback_max_stream_index=safe_int(v.get("fallback_max_stream_index")),
                )
        return entries
    except Exception:
        record_telemetry("cache_unreadable")
        return {}


def _save_cache(entries: Dict[str, CacheEntry]) -> None:
    if not (ENABLE_CACHE and CACHE_FILE):
        return
    try:
        os.makedirs(os.path.dirname(CACHE_FILE) or ".", exist_ok=True)
    except Exception:
        # Directory might not be creatable; silently give up.
        return

    payload = {
        "version": 1,
        "entries": {
            k: {
                "ts": v.ts,
                "rating_key": v.rating_key,
                "fallback_file": v.fallback_file,
                "fallback_height": v.fallback_height,
                "fallback_dr": v.fallback_dr,
                "fallback_max_stream_index": v.fallback_max_stream_index,
            }
            for k, v in entries.items()
        },
    }

    tmp = CACHE_FILE + ".tmp"
    try:
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2, sort_keys=True)
        os.replace(tmp, CACHE_FILE)
    except Exception:
        # Best-effort; do not break playback.
        try:
            if os.path.exists(tmp):
                os.unlink(tmp)
        except Exception:
            pass


# =====================================================================================
# Plex lookup: (file path) -> (library item) -> (fallback file)
# =====================================================================================


def _as_list(value) -> List[dict]:
    if not value:
        return []
    if isinstance(value, list):
        return [v for v in value if isinstance(v, dict)]
    if isinstance(value, dict):
        return [value]
    return []


def _iter_metadata_items(container_json: dict) -> Iterable[dict]:
    mc = (container_json or {}).get("MediaContainer", {})
    for item in _as_list(mc.get("Metadata")):
        yield item


def _item_has_file(item: dict, file_path: str) -> bool:
    medias = _as_list(item.get("Media"))
    for media in medias:
        for part in _as_list(media.get("Part")):
            if part.get("file") == file_path:
                return True
    return False


def _section_locations(section: dict) -> List[str]:
    locations = _as_list(section.get("Location"))
    paths = []
    for location in locations:
        path = (location.get("path") or "").rstrip("/")
        if path:
            paths.append(path)
    return paths


def _section_matches_file_path(section: dict, file_path: str) -> bool:
    normalized = os.path.abspath(file_path)
    for location in _section_locations(section):
        root = os.path.abspath(location)
        if normalized == root or normalized.startswith(root.rstrip("/") + os.sep):
            return True
    return False


def _section_all_params(section: dict) -> Dict[str, str]:
    params: Dict[str, str] = {}
    if section.get("type") == "show":
        params["type"] = "4"
    return params


def plex_find_item_by_file_via_sections(file_path: str) -> Optional[Tuple[str, dict]]:
    if not ENABLE_SECTION_SCAN_FALLBACK:
        return None
    if active_decision_budget_exhausted():
        return None
    sections = plex_get_json("/library/sections", params={})
    if not sections:
        return None
    candidates = [
        section
        for section in _as_list((sections.get("MediaContainer") or {}).get("Directory"))
        if _section_matches_file_path(section, file_path)
    ]
    for section in candidates:
        if active_decision_budget_exhausted():
            return None
        key = section.get("key")
        if not key:
            continue
        data = plex_get_json(f"/library/sections/{key}/all", params=_section_all_params(section))
        if not data:
            continue
        checked = 0
        for item in _iter_metadata_items(data):
            if active_decision_budget_exhausted():
                return None
            checked += 1
            if checked > SECTION_SCAN_MAX_ITEMS:
                break
            rk = item.get("ratingKey")
            if rk and _item_has_file(item, file_path):
                return str(rk), item
    return None


def _index_freshness_status(data: dict) -> Optional[str]:
    generated = safe_int(data.get("generated_at_epoch"))
    if VERSION_INDEX_MAX_AGE_S > 0:
        if generated is None:
            return "missing_generated_at"
        age = time.time() - generated
        if age < 0:
            return "future_generated_at"
        if age > VERSION_INDEX_MAX_AGE_S:
            return "stale"
    return None


def _v2_streams_from_row(row: dict, height: Optional[int]) -> List[dict]:
    raw_streams = row.get("streams") or row.get("Streams") or row.get("Stream")
    if isinstance(raw_streams, list) and all(isinstance(stream, dict) for stream in raw_streams):
        return list(raw_streams)
    max_stream_index = safe_int(row.get("max_stream_index") or row.get("maxStreamIndex") or row.get("max_stream"))
    streams: List[dict] = [{"streamType": 1, "index": 0, "height": height}]
    if max_stream_index is not None and max_stream_index > 0:
        for index in range(1, max_stream_index + 1):
            streams.append({"streamType": 2, "index": index})
    return streams


def _v2_media_from_version(row: dict, inherited_edition: str) -> Optional[dict]:
    if not isinstance(row, dict):
        return None
    file_path = str(row.get("file") or row.get("part_path") or row.get("path") or "").strip()
    if not file_path:
        return None
    height = safe_int(row.get("height") or row.get("video_height") or row.get("videoHeight"))
    dynamic_range = str(row.get("dynamic_range") or row.get("videoDynamicRange") or row.get("dynamicRange") or "UNKNOWN")
    bitrate = safe_int(row.get("bitrate_kbps") or row.get("bitrate") or row.get("videoBitrate") or row.get("videoBitrateKbps"))
    edition_key = str(row.get("edition_key") or row.get("edition") or row.get("editionTitle") or inherited_edition or "")
    part: dict = {"file": file_path, "Stream": _v2_streams_from_row(row, height)}
    if bitrate:
        part["bitrate"] = bitrate
    media: dict = {
        "height": height,
        "videoHeight": height,
        "videoResolution": str(height) if height else "",
        "videoDynamicRange": dynamic_range,
        "Part": [part],
    }
    if bitrate:
        media["bitrate"] = bitrate
        media["videoBitrate"] = bitrate
    if edition_key:
        media["editionTitle"] = edition_key
    return media


def _v2_entry_to_item(entry: dict) -> Optional[dict]:
    if not isinstance(entry, dict):
        return None
    rating_key = entry.get("rating_key") or entry.get("ratingKey") or entry.get("rating_key_id")
    if not rating_key:
        return None
    inherited_edition = str(entry.get("edition_key") or entry.get("edition") or entry.get("editionTitle") or "")
    versions = entry.get("versions") or entry.get("media") or entry.get("Media")
    if not isinstance(versions, list):
        return None
    medias = [media for row in versions if (media := _v2_media_from_version(row, inherited_edition))]
    if not medias:
        return None
    item: dict = {"ratingKey": str(rating_key), "Media": medias}
    if inherited_edition:
        item["editionTitle"] = inherited_edition
    return item


def _find_v2_index_item(data: dict, file_path: str) -> Optional[Tuple[str, dict]]:
    paths = data.get("paths") or data.get("path_index")
    if not isinstance(paths, dict):
        return None
    entry = paths.get(file_path) or paths.get(os.path.normpath(file_path))
    if not isinstance(entry, dict):
        return None
    item = _v2_entry_to_item(entry)
    if not item or not _item_has_file(item, file_path):
        return None
    return str(item["ratingKey"]), item


def plex_find_item_by_file_via_version_index(file_path: str) -> Optional[Tuple[str, dict]]:
    global VERSION_INDEX_LAST_STATUS
    index_path = (VERSION_INDEX_FILE or "").strip()
    if not index_path or not os.path.isfile(index_path):
        VERSION_INDEX_LAST_STATUS = "missing"
        return None
    try:
        with open(index_path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except Exception as exc:
        VERSION_INDEX_LAST_STATUS = "unreadable"
        log("DEBUG", f"Ignoring unreadable version index: {exc}")
        return None
    if not isinstance(data, dict):
        VERSION_INDEX_LAST_STATUS = "invalid"
        return None
    if safe_int(data.get("version")) != 2:
        VERSION_INDEX_LAST_STATUS = "invalid"
        return None
    paths = data.get("paths") or data.get("path_index")
    if not paths:
        VERSION_INDEX_LAST_STATUS = "empty"
        return None
    freshness_status = _index_freshness_status(data)
    if freshness_status:
        VERSION_INDEX_LAST_STATUS = freshness_status
        return None
    found_v2 = _find_v2_index_item(data, file_path)
    if found_v2:
        VERSION_INDEX_LAST_STATUS = "hit_v2"
        return found_v2
    VERSION_INDEX_LAST_STATUS = "miss"
    return None


def plex_find_item_by_file(file_path: str) -> Optional[Tuple[str, dict]]:
    """Find (rating_key, item_dict) for a given absolute media file path."""
    if not file_path:
        return None
    indexed = plex_find_item_by_file_via_version_index(file_path)
    if indexed:
        return indexed
    if not ALLOW_LIVE_LOOKUP_ON_INDEX_MISS:
        log("DEBUG", f"Version index status={VERSION_INDEX_LAST_STATUS} and live lookup is disabled; passing through")
        return None
    if active_decision_budget_exhausted():
        return None

    return plex_find_item_by_file_via_sections(file_path)


def plex_fetch_full_metadata(rating_key: str) -> Optional[dict]:
    if not rating_key:
        return None

    data = plex_get_json(f"/library/metadata/{rating_key}", params={})
    if not data:
        return None

    mc = data.get("MediaContainer", {})
    md = mc.get("Metadata") or []
    if isinstance(md, dict):
        md = [md]
    if not md:
        return None
    return md[0]


def plex_fetch_full_metadata_for_swap(
    rating_key: str,
    decision_start_ms: float,
    *,
    retry_for_protected: bool,
) -> Optional[dict]:
    attempts = 1 + (PROTECTED_LOOKUP_RETRY_ATTEMPTS if retry_for_protected else 0)
    for attempt in range(1, attempts + 1):
        if budget_exhausted(decision_start_ms):
            return None
        item = plex_fetch_full_metadata(rating_key)
        if item:
            if attempt > 1:
                record_telemetry(
                    "protected_metadata_retry_success",
                    elapsed_ms=monotonic_ms() - decision_start_ms,
                    index_status=VERSION_INDEX_LAST_STATUS,
                )
            return item
        if not retry_for_protected or attempt >= attempts:
            break
        record_telemetry(
            "protected_metadata_retry",
            elapsed_ms=monotonic_ms() - decision_start_ms,
            index_status=VERSION_INDEX_LAST_STATUS,
        )
        if PROTECTED_LOOKUP_RETRY_DELAY_MS > 0:
            remaining = remaining_decision_budget_s()
            if remaining is None or remaining <= 0:
                return None
            time.sleep(min(PROTECTED_LOOKUP_RETRY_DELAY_MS / 1000.0, remaining))
    return None


@dataclass
class MediaInfo:
    media: dict
    file_path: str
    height: Optional[int]
    bitrate_kbps: Optional[int]
    dyn_range: str
    dyn_range_class: str
    max_stream_index: Optional[int]
    edition_key: str


def build_media_info(media: dict) -> Optional[MediaInfo]:
    parts = media.get("Part") or []
    if isinstance(parts, dict):
        parts = [parts]
    if not parts:
        return None
    p0 = parts[0]
    fp = p0.get("file")
    if not fp:
        return None

    h = media_height(media)
    dr = media_dynamic_range(media)
    drc = classify_dynamic_range(dr)
    if drc == "UNKNOWN":
        inferred = dynamic_range_from_file_name(str(fp))
        if inferred != "UNKNOWN":
            dr = inferred
            drc = classify_dynamic_range(dr)
    msi = part_max_stream_index(media)
    return MediaInfo(
        media=media,
        file_path=str(fp),
        height=h,
        bitrate_kbps=media_bitrate_kbps(media),
        dyn_range=dr,
        dyn_range_class=drc,
        max_stream_index=msi,
        edition_key=media_edition_key(media),
    )


def find_current_media(full_item: dict, input_file: str) -> Optional[MediaInfo]:
    medias = full_item.get("Media") or []
    if isinstance(medias, dict):
        medias = [medias]
    for m in medias:
        parts = m.get("Part") or []
        if isinstance(parts, dict):
            parts = [parts]
        for p in parts:
            if p.get("file") == input_file:
                return build_media_info(m)
    return None


def is_protected_height(height: Optional[int]) -> bool:
    return height is not None and height >= MAX_ALLOWED_HEIGHT


def is_1080_remux_like(mi: MediaInfo) -> bool:
    if mi.height != 1080:
        return False
    if file_path_looks_remux(mi.file_path):
        return True
    return mi.bitrate_kbps is not None and mi.bitrate_kbps >= REMUX_1080_MIN_BITRATE_KBPS


def is_protected_source(mi: MediaInfo) -> bool:
    if is_protected_height(mi.height):
        return True
    if HARD_PROTECT_1080_HDR and mi.height == 1080 and mi.dyn_range_class not in ("SDR", "UNKNOWN"):
        return True
    if HARD_PROTECT_1080_REMUX and is_1080_remux_like(mi):
        return True
    return False


def should_waterfall_continued_transcode(mi: MediaInfo) -> bool:
    if not AUTO_WATERFALL_ON_CONTINUED_TRANSCODE:
        return False
    if mi.height is None or mi.height <= WATERFALL_MIN_HEIGHT:
        return False
    if is_protected_height(mi.height):
        return False
    return True


def pick_best_fallback(
    full_item: dict,
    current: MediaInfo,
    required_max_stream: Optional[int],
) -> Optional[MediaInfo]:
    """Return the best fallback MediaInfo according to policy."""

    def candidate_score(mi: MediaInfo) -> Tuple[int, int, int, int]:
        h = mi.height or 0
        if h in PREFER_HEIGHTS:
            pref_rank = list(PREFER_HEIGHTS).index(h)
        else:
            # After preferred heights, pick the biggest under the max.
            pref_rank = len(PREFER_HEIGHTS) + (MAX_ALLOWED_HEIGHT - h)
        return pref_rank, media_audio_risk(mi.media), media_subtitle_risk(mi.media), -h

    medias = full_item.get("Media") or []
    if isinstance(medias, dict):
        medias = [medias]

    # Two-pass selection
    if FALLBACK_SDR_ONLY:
        passes: List[Tuple[str, bool]] = [("SDR_ONLY", True)]
    else:
        if ALLOW_HDR_FALLBACK:
            passes = [("SDR_PREFERRED", True), ("ALLOW_HDR", False)]
        else:
            passes = [("ALLOW_HDR_ONLY", False)]

    for pass_name, sdr_only in passes:
        candidates: List[Tuple[MediaInfo, Tuple[int, int, int, int]]] = []

        for m in medias:
            mi = build_media_info(m)
            if not mi:
                continue

            # Exclude the currently requested file.
            if mi.file_path == current.file_path:
                continue
            if mi.edition_key != current.edition_key:
                continue

            # Must have a known height.
            if mi.height is None:
                continue

            # Never allow 4K-ish versions, and respect the explicit fallback max.
            if mi.height >= MAX_ALLOWED_HEIGHT:
                continue
            if mi.height > MAX_FALLBACK_HEIGHT:
                continue

            # Dynamic range policy.
            if sdr_only and mi.dyn_range_class != "SDR":
                continue

            # Only accept a real downshift, except allow equal height if we improve HDR->SDR.
            acceptable = False
            if current.height is not None:
                if mi.height < current.height:
                    acceptable = True
                elif current.dyn_range_class != "SDR" and mi.dyn_range_class == "SDR" and mi.height <= current.height:
                    acceptable = True
            else:
                acceptable = True

            if not acceptable:
                continue

            # Stream index compatibility check (optional).
            if REQUIRE_STREAM_INDEX_COMPATIBILITY and required_max_stream is not None:
                if mi.max_stream_index is None or mi.max_stream_index < required_max_stream:
                    continue

            candidates.append((mi, candidate_score(mi)))

        if candidates:
            candidates.sort(key=lambda t: t[1])
            best = candidates[0][0]
            log(
                "DEBUG",
                f"Fallback pass={pass_name} candidates="
                f"{[(c[0].height, c[0].dyn_range_class, os.path.basename(c[0].file_path)) for c in candidates[:5]]}",
            )
            return best

    return None


def protected_waterfall_decision(
    args: List[str],
    input_idx: int,
    input_file: str,
    rating_key: str,
    full_item: dict,
    current: MediaInfo,
    required_max_stream: Optional[int],
    decision_start_ms: float,
) -> List[str]:
    fallback = pick_best_fallback(full_item, current, required_max_stream)
    if not fallback:
        log("WARNING", "No compliant fallback version found (or none passed stream safety checks)")
        record_telemetry("no_fallback", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if is_protected_height(current.height) and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("no verified lower fallback", decision_start_ms)
        if KILL_TRANSCODE_IF_NO_FALLBACK:
            log("ERROR", "Policy: killing protected transcode (KILL_TRANSCODE_IF_NO_FALLBACK=1)")
            sys.exit(1)
        return args

    if SHADOW_MODE and is_protected_height(current.height) and not FOUR_K_TRANSCODE_ALLOWED:
        log("WARNING", "Shadow mode overridden because protected source transcode is not allowed")

    args[input_idx] = fallback.file_path
    swapped_to_sdr = fallback.dyn_range_class == "SDR"
    outcome = "waterfall_swap" if VERSION_INDEX_LAST_STATUS.startswith("hit") else "live_lookup_waterfall_swap"
    log(
        "INFO",
        f"{outcome}: {current.height}p/{current.dyn_range_class} -> {fallback.height}p/{fallback.dyn_range_class} "
        f"({os.path.basename(fallback.file_path)})",
    )
    if ENABLE_CACHE:
        cache = _load_cache()
        cache[input_file] = CacheEntry(
            ts=time.time(),
            rating_key=rating_key,
            fallback_file=fallback.file_path,
            fallback_height=fallback.height,
            fallback_dr=fallback.dyn_range,
            fallback_max_stream_index=fallback.max_stream_index,
        )
        _save_cache(cache)
    record_telemetry(outcome, elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
    return rewrite_args_for_performance(args, input_idx, swapped_to_sdr)


def attempt_protected_waterfall_fast_path(
    args: List[str],
    input_idx: int,
    input_file: str,
    rating_key: str,
    full_item: dict,
    current: MediaInfo,
    required_max_stream: Optional[int],
    decision_start_ms: float,
) -> Optional[List[str]]:
    """Use v2 locator proof, then authoritative Plex metadata, before generic lookup logic."""
    if not is_protected_source(current):
        return None
    if budget_exhausted(decision_start_ms):
        block_4k_transcode("decision budget exhausted before metadata", decision_start_ms)
    full_metadata = plex_fetch_full_metadata_for_swap(
        rating_key,
        decision_start_ms,
        retry_for_protected=True,
    )
    if budget_exhausted(decision_start_ms):
        block_4k_transcode("decision budget exhausted during metadata", decision_start_ms)
    if not full_metadata:
        block_4k_transcode("authoritative Plex metadata unavailable", decision_start_ms)
    authoritative_current = find_current_media(full_metadata, input_file)
    if not authoritative_current:
        block_4k_transcode("current media absent from authoritative Plex metadata", decision_start_ms)
    if not is_protected_source(authoritative_current):
        return None
    return protected_waterfall_decision(
        args,
        input_idx,
        input_file,
        rating_key,
        full_metadata,
        authoritative_current,
        required_max_stream,
        decision_start_ms,
    )


# =====================================================================================
# Argument rewriting / optimization
# =====================================================================================


_TONEMAP_RE = re.compile(
    # Match a filter token that starts either at the beginning of the graph OR immediately after a separator/combinator.
    #
    # In Plex-generated filter graphs, tonemap related filters typically appear after an input label (']') or after ',' / ';'.
    r"(^|[,;\]])(?P<name>tonemap|libplacebo|procamp|zscale)(?P<opts>=[^,;\[]*)?",
    re.IGNORECASE,
)


def _rewrite_filter_graph(filters: str) -> Tuple[str, bool]:
    """Rewrite filter graphs by replacing tonemap-related filters with 'null'.

    Returns (new_filters, changed).
    """

    def repl(m: re.Match) -> str:
        prefix = m.group(1) or ""
        name = (m.group("name") or "").lower()
        opts = m.group("opts") or ""

        if name == "zscale":
            # Don't nuke zscale if it looks like it's doing resizing. (zscale used for HDR colorspace conversion typically has t=/transfer=/npl=/primaries=/matrix=)
            o = opts.lower()
            if "w=" in o or "h=" in o:
                return prefix + name + opts
            return prefix + "null"

        # For tonemap/libplacebo/procamp, replace with null unconditionally.
        return prefix + "null"

    new_s, n = _TONEMAP_RE.subn(repl, filters)
    return new_s, (n > 0 and new_s != filters)


def rewrite_args_for_performance(
    args: List[str],
    input_value_index: int,
    swapped_to_sdr: bool,
) -> List[str]:
    """Return a rewritten arg list (or the original list if no changes were needed)."""
    if not swapped_to_sdr and not REMOVE_BITRATE_LIMITS:
        return args

    out: List[str] = []
    i = 0
    while i < len(args):
        a = args[i]

        # Plex places source decoder hints before -i. After replacing the input
        # file those hints can force the wrong decoder (for example truehd_eae
        # against an AAC fallback), so remove only pre-input decoder/EAE hints.
        if swapped_to_sdr and input_value_index >= 0 and i < input_value_index:
            if a == "-codec" or a.startswith("-codec:") or a.startswith("-eae_prefix:"):
                if i + 1 < len(args):
                    log("DEBUG", f"Optimization: removed stale input hint {a} {args[i + 1]}")
                    i += 2
                    continue

        # Bitrate limit stripping: only after the input, so we don't touch decoder hints.
        if REMOVE_BITRATE_LIMITS and input_value_index >= 0 and i > input_value_index:
            if a in ("-b", "-b:v", "-maxrate", "-bufsize") or a.startswith("-b:") or a.startswith("-maxrate:") or a.startswith("-bufsize:"):
                if i + 1 < len(args):
                    log("DEBUG", f"Optimization: removed bitrate option {a} {args[i + 1]}")
                    i += 2
                    continue

        # HDR tone mapping stripping: rewrite the filter graph, don't delete it.
        if swapped_to_sdr and STRIP_HDR_TONEMAP_FILTERS and a in ("-filter_complex", "-vf"):
            if i + 1 < len(args):
                original = args[i + 1]
                rewritten, changed = _rewrite_filter_graph(original)
                out.append(a)
                out.append(rewritten)
                if changed:
                    log("DEBUG", "Optimization: replaced tone-mapping filters with 'null' (swap-to-SDR)")
                i += 2
                continue

        out.append(a)
        i += 1

    return out


# =====================================================================================
# Exec real transcoder
# =====================================================================================


def resolve_real_transcoder_path() -> str:
    """Resolve the on-disk path to the real Plex Transcoder binary."""
    shim_path = os.path.realpath(sys.argv[0])
    if REAL_TRANSCODER_PATH.strip():
        real_path = os.path.realpath(REAL_TRANSCODER_PATH.strip())
        if real_path == shim_path:
            raise RuntimeError("Real transcoder path must not resolve to the shim itself")
        return REAL_TRANSCODER_PATH.strip()

    # Default: same directory as this shim, plus suffix.
    candidate = shim_path + REAL_TRANSCODER_SUFFIX
    if os.path.realpath(candidate) == shim_path:
        raise RuntimeError("Real transcoder suffix must not resolve to the shim itself")
    if os.path.exists(candidate) and os.access(candidate, os.X_OK):
        return candidate

    # Common diverted Plex locations. Never fall back to the undiverted
    # "Plex Transcoder" path; that can recurse into this shim.
    common = [
        "/usr/lib/plexmediaserver/Plex Transcoder" + REAL_TRANSCODER_SUFFIX,
        "/usr/lib/plexmediaserver/Plex Transcoder.downshiftarr-real",
    ]
    for p in common:
        if os.path.exists(p) and os.access(p, os.X_OK) and os.path.realpath(p) != shim_path:
            return p

    return candidate  # will error later with a helpful log


def exec_real_transcoder(real_path: str, args: Sequence[str]) -> None:
    try:
        os.execv(real_path, [real_path] + list(args))
    except OSError as e:
        log("ERROR", f"CRITICAL: could not exec real transcoder at '{real_path}': {e}")
        sys.exit(1)


# =====================================================================================
# Main
# =====================================================================================


def main() -> None:
    global _ACTIVE_DECISION_START_MS
    decision_start_ms = monotonic_ms()
    _ACTIVE_DECISION_START_MS = decision_start_ms
    args = sys.argv[1:]
    real = resolve_real_transcoder_path()

    # Safety: If we cannot resolve the real transcoder, there's no point continuing.
    if not os.path.exists(real):
        log("ERROR", f"Real transcoder not found at '{real}'. Check REAL_TRANSCODER_PATH / rename suffix.")
        sys.exit(1)

    # Scope limiter: avoid touching non-streaming jobs.
    if ONLY_INTERCEPT_STREAMING_TRANSCODES and not is_streaming_transcode(args):
        exec_real_transcoder(real, args)
        return

    input_file, input_idx = find_primary_input(args)
    if not input_file or input_idx < 0:
        # We can't identify the primary video input; pass through.
        exec_real_transcoder(real, args)
        return

    if SKIP_WHEN_VIDEO_CODEC_COPY and video_codec_is_copy(args, input_idx):
        exec_real_transcoder(real, args)
        return

    # Parse required input stream indices from the args (for safe swapping).
    req_stream_max = required_max_input_stream_index(args)
    input_looks_4k = file_path_looks_4k(input_file) or (
        HARD_PROTECT_1080_REMUX and file_path_height_hint(input_file) == 1080 and file_path_looks_remux(input_file)
    )
    preverified_index_found: Optional[Tuple[str, dict]] = plex_find_item_by_file_via_version_index(input_file)
    preverified_current = find_current_media(preverified_index_found[1], input_file) if preverified_index_found else None
    preverified_source_protected = bool(preverified_current and is_protected_source(preverified_current))

    if preverified_index_found and preverified_current and preverified_source_protected:
        final_args = attempt_protected_waterfall_fast_path(
            args,
            input_idx,
            input_file,
            preverified_index_found[0],
            preverified_index_found[1],
            preverified_current,
            req_stream_max,
            decision_start_ms,
        )
        if final_args is not None:
            exec_real_transcoder(real, final_args)
            return

    # Cache fast-path. Only trust the generic fallback cache after a fresh
    # version index proves the source is not protected; protected decisions must
    # always use same-item/same-edition version proof, never a stale fallback row.
    if (
        ENABLE_CACHE
        and preverified_current is not None
        and not preverified_source_protected
        and not (input_looks_4k and REQUIRE_FRESH_INDEX_FOR_4K)
    ):
        cache = _load_cache()
        ce = cache.get(input_file)
        if ce and ce.fallback_file:
            if not os.path.exists(ce.fallback_file):
                log("DEBUG", "Cache hit but fallback file no longer exists; ignoring")
            elif REQUIRE_STREAM_INDEX_COMPATIBILITY and req_stream_max is not None:
                if ce.fallback_max_stream_index is None or ce.fallback_max_stream_index < req_stream_max:
                    log("DEBUG", "Cache hit but stream compatibility is insufficient; ignoring")
                else:
                    log("INFO", f"Cache hit: swapping input -> {os.path.basename(ce.fallback_file)}")
                    args[input_idx] = ce.fallback_file
                    swapped_to_sdr = classify_dynamic_range(ce.fallback_dr) == "SDR"
                    final_args = rewrite_args_for_performance(args, input_idx, swapped_to_sdr)
                    record_telemetry("cache_swap", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
                    exec_real_transcoder(real, final_args)
                    return
            else:
                log("INFO", f"Cache hit: swapping input -> {os.path.basename(ce.fallback_file)}")
                args[input_idx] = ce.fallback_file
                swapped_to_sdr = classify_dynamic_range(ce.fallback_dr) == "SDR"
                final_args = rewrite_args_for_performance(args, input_idx, swapped_to_sdr)
                record_telemetry("cache_swap", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
                exec_real_transcoder(real, final_args)
                return

    if budget_exhausted(decision_start_ms):
        log("WARNING", f"Decision budget exhausted before Plex lookup; passing through budget_ms={DECISION_BUDGET_MS}")
        record_telemetry("budget_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("decision budget exhausted before lookup", decision_start_ms)
        if source_actual_height_unproven(input_file, preverified_current):
            block_unknown_actual_height(input_file, decision_start_ms, "decision budget exhausted before lookup")
        exec_real_transcoder(real, args)
        return

    # Lookup item by exact file path.
    found = preverified_index_found or plex_find_item_by_file(input_file)
    if budget_exhausted(decision_start_ms):
        log("WARNING", f"Decision budget exhausted during Plex lookup; passing through budget_ms={DECISION_BUDGET_MS}")
        record_telemetry("budget_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("decision budget exhausted during lookup", decision_start_ms)
        if source_actual_height_unproven(input_file, preverified_current):
            block_unknown_actual_height(input_file, decision_start_ms, "decision budget exhausted during lookup")
        exec_real_transcoder(real, args)
        return
    if not found:
        log("WARNING", f"Plex lookup failed for input file: {input_file}")
        record_telemetry("lookup_failed", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("lookup uncertain", decision_start_ms)
        if source_actual_height_unproven(input_file, preverified_current):
            block_unknown_actual_height(input_file, decision_start_ms, "lookup uncertain")
        if KILL_TRANSCODE_IF_UNSURE:
            log("ERROR", "Policy: killing streaming transcode because we are unsure (KILL_TRANSCODE_IF_UNSURE=1)")
            sys.exit(1)
        exec_real_transcoder(real, args)
        return

    rating_key, search_item = found
    if budget_exhausted(decision_start_ms):
        log("WARNING", f"Decision budget exhausted after Plex lookup; passing through budget_ms={DECISION_BUDGET_MS}")
        record_telemetry("budget_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        found_current = find_current_media(found[1], input_file) if found else preverified_current
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("decision budget exhausted after lookup", decision_start_ms)
        if source_actual_height_unproven(input_file, found_current):
            block_unknown_actual_height(input_file, decision_start_ms, "decision budget exhausted after lookup")
        exec_real_transcoder(real, args)
        return

    # -----------------------------------------------------------------------------
    # Fast path: if the search response is already enough to tell us this is NOT protected, skip the more expensive full-metadata fetch.
    # -----------------------------------------------------------------------------
    if FAST_PATH_SKIP_FULL_METADATA_IF_UNPROTECTED:
        current_quick = find_current_media(search_item, input_file)
        if current_quick and current_quick.height is not None:
            if (
                (not is_protected_source(current_quick))
                and (not should_waterfall_continued_transcode(current_quick))
                and (not args_indicate_hdr_tonemap(args))
            ):
                record_telemetry("fast_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
                exec_real_transcoder(real, args)
                return

    if budget_exhausted(decision_start_ms):
        log("WARNING", f"Decision budget exhausted before full metadata; passing through budget_ms={DECISION_BUDGET_MS}")
        record_telemetry("budget_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        current_search = find_current_media(search_item, input_file)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("decision budget exhausted before metadata", decision_start_ms)
        if source_actual_height_unproven(input_file, current_search):
            block_unknown_actual_height(input_file, decision_start_ms, "decision budget exhausted before metadata")
        exec_real_transcoder(real, args)
        return

    # Fetch authoritative metadata (streams / dynamic range / sibling versions).
    # The v2 index is only a fast exact-path locator; every swap decision must use
    # Plex's current `/library/metadata/<ratingKey>` response.
    current_quick_for_retry = find_current_media(search_item, input_file)
    retry_metadata = bool(
        (input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED)
        or (current_quick_for_retry and is_protected_source(current_quick_for_retry))
    )
    full_item = plex_fetch_full_metadata_for_swap(
        rating_key,
        decision_start_ms,
        retry_for_protected=retry_metadata,
    )
    if budget_exhausted(decision_start_ms):
        log("WARNING", f"Decision budget exhausted during full metadata fetch; passing through budget_ms={DECISION_BUDGET_MS}")
        record_telemetry("budget_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("decision budget exhausted during metadata", decision_start_ms)
        if source_actual_height_unproven(input_file, current_quick_for_retry):
            block_unknown_actual_height(input_file, decision_start_ms, "decision budget exhausted during metadata")
        exec_real_transcoder(real, args)
        return
    if not full_item:
        log("WARNING", f"Could not fetch full metadata for ratingKey={rating_key}")
        record_telemetry("metadata_failed", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("metadata unavailable", decision_start_ms)
        if source_actual_height_unproven(input_file, current_quick_for_retry):
            block_unknown_actual_height(input_file, decision_start_ms, "metadata unavailable")
        if KILL_TRANSCODE_IF_UNSURE:
            log("ERROR", "Policy: killing streaming transcode because we are unsure (KILL_TRANSCODE_IF_UNSURE=1)")
            sys.exit(1)
        exec_real_transcoder(real, args)
        return

    current = find_current_media(full_item, input_file)
    if not current:
        log("WARNING", "Could not match current media in full metadata")
        record_telemetry("current_media_miss", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if input_looks_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("current 4K media not verified", decision_start_ms)
        if source_actual_height_unproven(input_file, current_quick_for_retry):
            block_unknown_actual_height(input_file, decision_start_ms, "current media not verified")
        if KILL_TRANSCODE_IF_UNSURE:
            log("ERROR", "Policy: killing streaming transcode because we are unsure (KILL_TRANSCODE_IF_UNSURE=1)")
            sys.exit(1)
        exec_real_transcoder(real, args)
        return

    protected = is_protected_source(current)
    current_is_4k = is_protected_height(current.height)
    if (not protected) and (current.dyn_range_class == "UNKNOWN") and args_indicate_hdr_tonemap(args):
        # Plex is tonemapping, so treat the source as HDR even if metadata didn't say so.
        protected = True
    continued_waterfall = (not protected) and should_waterfall_continued_transcode(current)

    if not protected and not continued_waterfall:
        record_telemetry("policy_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        exec_real_transcoder(real, args)
        return

    if budget_exhausted(decision_start_ms):
        log("WARNING", f"Decision budget exhausted before fallback selection; passing through budget_ms={DECISION_BUDGET_MS}")
        record_telemetry("budget_passthrough", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if (input_looks_4k or current_is_4k) and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("decision budget exhausted before fallback selection", decision_start_ms)
        exec_real_transcoder(real, args)
        return

    if protected:
        log(
            "INFO",
            f"Protected source detected: height={current.height} dyn_range={current.dyn_range_class} "
            f"file={os.path.basename(current.file_path)}",
        )
    else:
        log(
            "INFO",
            f"Continued transcode waterfall: height={current.height} dyn_range={current.dyn_range_class} "
            f"file={os.path.basename(current.file_path)}",
        )

    if protected:
        final_args = protected_waterfall_decision(
            args, input_idx, input_file, rating_key, full_item, current, req_stream_max, decision_start_ms
        )
        exec_real_transcoder(real, final_args)
        return

    fallback = pick_best_fallback(full_item, current, req_stream_max)
    if not fallback:
        log("WARNING", "No compliant fallback version found (or none passed stream safety checks)")
        record_telemetry("no_fallback", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        if current_is_4k and not FOUR_K_TRANSCODE_ALLOWED:
            block_4k_transcode("no verified lower fallback", decision_start_ms)
        if protected and KILL_TRANSCODE_IF_NO_FALLBACK:
            log("ERROR", "Policy: killing protected transcode (KILL_TRANSCODE_IF_NO_FALLBACK=1)")
            sys.exit(1)
        exec_real_transcoder(real, args)
        return

    if SHADOW_MODE and not (current_is_4k and not FOUR_K_TRANSCODE_ALLOWED):
        log(
            "INFO",
            f"Shadow mode: would waterfall swap {current.height}p/{current.dyn_range_class} -> "
            f"{fallback.height}p/{fallback.dyn_range_class} ({os.path.basename(fallback.file_path)})",
        )
        record_telemetry("shadow_swap_candidate", elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
        exec_real_transcoder(real, args)
        return
    if SHADOW_MODE and current_is_4k and not FOUR_K_TRANSCODE_ALLOWED:
        log("WARNING", "Shadow mode overridden because 4K transcode is not allowed")

    # Swap input to the fallback file.
    args[input_idx] = fallback.file_path
    swapped_to_sdr = fallback.dyn_range_class == "SDR"

    outcome = "waterfall_swap" if VERSION_INDEX_LAST_STATUS.startswith("hit") else "live_lookup_waterfall_swap"
    log(
        "INFO",
        f"{outcome}: {current.height}p/{current.dyn_range_class} -> {fallback.height}p/{fallback.dyn_range_class} "
        f"({os.path.basename(fallback.file_path)})",
    )

    # Update cache.
    if ENABLE_CACHE:
        cache = _load_cache()
        cache[input_file] = CacheEntry(
            ts=time.time(),
            rating_key=rating_key,
            fallback_file=fallback.file_path,
            fallback_height=fallback.height,
            fallback_dr=fallback.dyn_range,
            fallback_max_stream_index=fallback.max_stream_index,
        )
        _save_cache(cache)

    # Rewrite args for performance and exec.
    final_args = rewrite_args_for_performance(args, input_idx, swapped_to_sdr)
    record_telemetry(outcome, elapsed_ms=monotonic_ms() - decision_start_ms, index_status=VERSION_INDEX_LAST_STATUS)
    exec_real_transcoder(real, final_args)


if __name__ == "__main__":
    main()
