# Helpers: logging
# =====================================================================================


_LOG_LEVELS: Dict[str, int] = {"DEBUG": 10, "INFO": 20, "WARNING": 30, "ERROR": 40}


def _log_level_value(level: str) -> int:
    return _LOG_LEVELS.get((level or "").upper().strip(), 20)


def log(level: str, message: str) -> None:
    if not LOG_FILE:
        return
    if _log_level_value(level) < _log_level_value(LOG_LEVEL):
        return
    try:
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        pid = os.getpid()
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] [{level.upper():7}] [PID:{pid}] {message}\n")
    except Exception:
        # Swallow logging errors; they are never worth breaking playback.
        pass


def monotonic_ms() -> float:
    return time.monotonic() * 1000.0


def budget_exhausted(start_ms: float) -> bool:
    if DECISION_BUDGET_MS <= 0:
        return True
    return (monotonic_ms() - start_ms) >= DECISION_BUDGET_MS


def remaining_decision_budget_s() -> Optional[float]:
    if _ACTIVE_DECISION_START_MS is None:
        return None
    if DECISION_BUDGET_MS <= 0:
        return 0.0
    remaining_ms = DECISION_BUDGET_MS - (monotonic_ms() - _ACTIVE_DECISION_START_MS)
    return max(0.0, remaining_ms / 1000.0)


def safe_client_family(value: object = "") -> str:
    raw = str(value or "").lower()
    if "roku" in raw:
        return "roku"
    if "fire" in raw:
        return "fire_tv"
    if "shield" in raw:
        return "nvidia_shield"
    if "android tv" in raw or "google tv" in raw:
        return "android_tv"
    if "android" in raw:
        return "android"
    if "ipad" in raw or "ipados" in raw:
        return "ipados"
    if "iphone" in raw or "ios" in raw:
        return "ios"
    if "apple tv" in raw or "tvos" in raw:
        return "apple_tv"
    if "chromecast" in raw:
        return "chromecast"
    if "samsung" in raw or "tizen" in raw:
        return "samsung_tv"
    if "lg" in raw or "webos" in raw:
        return "lg_tv"
    if "xbox" in raw:
        return "xbox"
    if "playstation" in raw or "ps5" in raw or "ps4" in raw:
        return "playstation"
    if "relay" in raw:
        return "relay"
    if "web" in raw or "chrome" in raw or "firefox" in raw or "safari" in raw or "edge" in raw:
        return "plex_web"
    if "htpc" in raw or "desktop" in raw:
        return "desktop"
    return "unknown"


def _empty_telemetry() -> dict:
    return {
        "version": 1,
        "outcomes": {},
        "client_families": {},
        "latency_ms": {"count": 0, "sum": 0.0, "max": 0.0},
        "version_index": {},
    }


def _increment_counter(root: dict, section: str, key: str, amount: int = 1) -> None:
    bucket = root.setdefault(section, {})
    row = bucket.setdefault(key, {"count": 0})
    row["count"] = int(row.get("count", 0)) + amount


def record_telemetry(
    outcome: str,
    *,
    elapsed_ms: Optional[float] = None,
    client_family: object = "",
    index_status: str = "",
) -> None:
    if not (TELEMETRY_ENABLED and TELEMETRY_FILE):
        return
    try:
        os.makedirs(os.path.dirname(TELEMETRY_FILE) or ".", exist_ok=True)
        try:
            with open(TELEMETRY_FILE, "r", encoding="utf-8") as handle:
                data = json.load(handle)
            if not isinstance(data, dict) or data.get("version") != 1:
                data = _empty_telemetry()
        except Exception:
            data = _empty_telemetry()

        _increment_counter(data, "outcomes", re.sub(r"[^a-z0-9_.-]+", "_", str(outcome).lower()).strip("_") or "unknown")
        family = safe_client_family(client_family)
        _increment_counter(data, "client_families", family)
        if index_status:
            _increment_counter(data, "version_index", re.sub(r"[^a-z0-9_.-]+", "_", index_status.lower()).strip("_") or "unknown")
        if elapsed_ms is not None:
            latency = data.setdefault("latency_ms", {"count": 0, "sum": 0.0, "max": 0.0})
            value = max(0.0, float(elapsed_ms))
            latency["count"] = int(latency.get("count", 0)) + 1
            latency["sum"] = round(float(latency.get("sum", 0.0)) + value, 3)
            latency["max"] = round(max(float(latency.get("max", 0.0)), value), 3)

        tmp = TELEMETRY_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as handle:
            json.dump(data, handle, sort_keys=True)
        os.replace(tmp, TELEMETRY_FILE)
    except Exception:
        pass


