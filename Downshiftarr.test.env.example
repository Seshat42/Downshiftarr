# Local-only Loki Plex integration settings.
# Copy to Downshiftarr.test.env and fill in values. Never commit real tokens.

DOWNSHIFTARR_LOKI_PLEX_URL=http://127.0.0.1:32400
DOWNSHIFTARR_LOKI_EXPECTED_MACHINE_ID=165cc0187d76937eb104da8d46437bf5443ec503
DOWNSHIFTARR_LOKI_TEST_LIBRARY_NAME=Downshiftarr Test Rig
DOWNSHIFTARR_LOKI_TEST_USERNAME=replace-with-local-test-user
DOWNSHIFTARR_TEST_MEDIA_DIR=artifacts/plex-test-media
DOWNSHIFTARR_TAUTULLI_URL=http://127.0.0.1:18181
TAUTULLI_URL=http://127.0.0.1:18181

# Required only for destructive Loki library refresh tests.
DOWNSHIFTARR_LOKI_PLEX_TOKEN=YOUR_PLEX_TOKEN_HERE
DOWNSHIFTARR_TAUTULLI_APIKEY=YOUR_LOCAL_TAUTULLI_API_KEY_HERE
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=YOUR_PLEX_TOKEN_HERE
TAUTULLI_APIKEY=YOUR_LOCAL_TAUTULLI_API_KEY_HERE
DOWNSHIFTARR_LOKI_ALLOW_DESTRUCTIVE=0

# Optional browser smoke settings. Leave disabled unless Playwright and a local
# browser session are intentionally configured.
DOWNSHIFTARR_LOKI_BROWSER=0
DOWNSHIFTARR_LOKI_BROWSER_HEADLESS=1
