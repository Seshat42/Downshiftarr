#!/usr/bin/python3
"""Downshiftarr Plex Transcoder Shim

This file is designed to *replace* the real "Plex Transcoder" binary on Linux.

Why this exists:
  - Plex will happily start transcoding a 4K / HDR / Dolby Vision source even when
    you have a perfectly good 1080p SDR version sitting right next to it.
  - Downshiftarr.py (triggered by Tautulli) is great at *reacting* to that, but it
    still has to wait for a session to exist.

So this shim becomes the *first line of defense*:
  1) Plex spawns "Plex Transcoder" (this shim)
  2) The shim decides whether the requested input is "protected" (4K-ish and/or
     HDR/DV)
  3) If protected: try to swap the input to an existing compliant version (e.g. 1080p SDR)
  4) If we cannot safely swap: optionally fail-closed (exit non‑zero) to prevent any
     protected transcoding from ever starting.
  5) Finally exec() the real transcoder so there is no long-running wrapper process.

Important reality check:
  - This shim cannot see the Plex session/user/client context the way Downshiftarr.py can.
  - This shim is therefore *not* a full replacement for Downshiftarr.py.
  - For best results / “100% compliance” you run BOTH:
      • Plex Transcoder shim (prevent / redirect work at spawn-time)
      • Downshiftarr.py (Tautulli-driven enforcement + client switching + termination)

The code is intentionally dependency-free (stdlib only) so it can run in minimal
Plex environments.
"""

from __future__ import annotations

import json
import os
import re
import stat
import sys
import time
import urllib.parse
import urllib.request
from dataclasses import dataclass
from typing import Dict, Iterable, List, Optional, Sequence, Tuple

# =====================================================================================
# Configuration
# =====================================================================================
# Tip:
#   Keep the policy values aligned with Downshiftarr.env / Downshiftarr.py so both
#   components agree on what “protected” means and what a “compliant fallback” is.
# =====================================================================================


# --- 1) How to locate / exec the real Plex Transcoder binary -------------------------

# Recommended: leave this empty and the shim will auto-detect by looking for
# "<this file>_REAL".
REAL_TRANSCODER_PATH: str = ""

# Suffix used when you rename the original binary.
# Example:
#   mv "Plex Transcoder" "Plex Transcoder_REAL"
REAL_TRANSCODER_SUFFIX: str = "_REAL"


# --- 2) Logging ----------------------------------------------------------------------

# Set to "" to disable file logging.
LOG_FILE: str = "/config/plex_transcoder_shim.log"

# One of: "DEBUG", "INFO", "WARNING", "ERROR".
LOG_LEVEL: str = "INFO"


# --- 3) Plex API connectivity --------------------------------------------------------

# Plex Media Server base URL. In Docker this is usually 127.0.0.1:32400 *inside the container*.
PLEX_URL: str = "http://127.0.0.1:32400"

# Token used for Plex API calls.
#
# Security-friendly default: leave blank and provide either PLEX_TOKEN_FILE or
# a Plex-provided token environment variable. Avoid putting tokens in JSON when
# the deployment can use a root-owned service-readable token file instead.
PLEX_TOKEN: str = ""

# Optional root-owned token file. This keeps tokens out of process argv,
# command-line examples, and the immutable shim binary while still allowing
# deployments where Plex does not pass X_PLEX_TOKEN to the transcoder process.
PLEX_TOKEN_FILE: str = ""

# Environment variables to check for a token if PLEX_TOKEN is blank.
PLEX_TOKEN_ENV_VARS: Tuple[str, ...] = (
    "X_PLEX_TOKEN",            # commonly present
    "PLEX_TOKEN",              # sometimes present
    "PLEX_CLAIM_TOKEN",        # harmless to try
)

# Network timeout for Plex API calls (seconds). Keep this small to avoid delaying playback.
PLEX_HTTP_TIMEOUT_S: float = 0.75

# Search endpoints to try (newer Plex typically supports /hubs/search).
# We try them in order and fall back if one fails.
PLEX_SEARCH_ENDPOINTS: Tuple[str, ...] = (
    "/hubs/search",
    "/hubs/search/",
    "/search",
    "/search/",
)

# Max items returned per hub for /hubs/search.
# If your libraries are huge and you have generic file names, raising this can help.
PLEX_SEARCH_LIMIT_PER_HUB: int = 25

# Some Plex libraries do not return file-name searches for versioned media even
# though `/library/sections/<key>/all` contains the exact Part file. Keep this
# fallback bounded and section-location scoped so the shim can still find
# version siblings without scanning unrelated libraries.
ENABLE_SECTION_SCAN_FALLBACK: bool = True
SECTION_SCAN_MAX_ITEMS: int = 1000

# Optional hot-path version index. When present, this avoids synchronous Plex
# search/section scans during the first transcode segment.
VERSION_INDEX_FILE: str = "/var/lib/downshiftarr/cache/plex-version-index.json"

# Reject stale hot-path indexes when they carry generation metadata. Missing
# generation metadata remains usable for backward compatibility but is reported.
VERSION_INDEX_MAX_AGE_S: int = 15 * 60
VERSION_INDEX_LAST_STATUS: str = "not_checked"


# --- 4) Intercept scope (avoid breaking non-streaming transcoder jobs) ----------------

# Only intercept streaming transcodes (DASH/HLS). Recommended.
ONLY_INTERCEPT_STREAMING_TRANSCODES: bool = True

# Formats Plex uses for segmented streaming. Plex's universal HLS path invokes
# ffmpeg's segment muxers even though the client-facing protocol is HLS.
STREAMING_OUTPUT_FORMATS: Tuple[str, ...] = ("dash", "hls", "ssegment", "segment")

# If video is being copied (direct stream/remux or audio-only transcode), do not interfere.
SKIP_WHEN_VIDEO_CODEC_COPY: bool = True


# --- 5) Policy: what counts as "protected" and what counts as "compliant" -------------

# Height threshold used to treat the source as "4K-ish".
# Keep aligned with Downshiftarr.py MAX_ALLOWED_HEIGHT default (2000).
MAX_ALLOWED_HEIGHT: int = 2000

# Do not allow the shim to select a fallback above this height.
# Default 1080 keeps the goal very clear: swap to a 1080p or lower version.
MAX_FALLBACK_HEIGHT: int = 1080

# Preferred fallback heights in priority order.
# Keep aligned with Downshiftarr.env PREFER_HEIGHTS.
PREFER_HEIGHTS: Tuple[int, ...] = (1080, 720, 576, 480, 360)

# Dynamic range policy.
# - If True: only swap to SDR fallbacks.
# - If False: SDR is preferred, but HDR/DV fallbacks are allowed depending on ALLOW_HDR_FALLBACK.
FALLBACK_SDR_ONLY: bool = True

# Only used when FALLBACK_SDR_ONLY is False.
ALLOW_HDR_FALLBACK: bool = False

# If the Plex metadata we can see does not clearly state HDR/DV, we can still infer that Plex *believes* the source is HDR when the transcoder arguments contain HDR->SDR tone-mapping filters.
#
# This helps catch cases like 1080p HDR sources when the metadata response is thin.
TREAT_TONEMAP_ARGS_AS_HDR: bool = True

# Speed optimization: avoid fetching the full `/library/metadata/<ratingKey>` payload unless the search result (or args) indicates the source might be protected.
#
# This saves one Plex API call for the *common* case (non-protected transcodes).
FAST_PATH_SKIP_FULL_METADATA_IF_UNPROTECTED: bool = True

# If a client is still transcoding an already downshifted SDR source, keep moving
# to the next lower available version until the lowest configured version remains.
AUTO_WATERFALL_ON_CONTINUED_TRANSCODE: bool = True
WATERFALL_MIN_HEIGHT: int = 360


# --- 6) Enforcement (fail-open vs fail-closed) ---------------------------------------

# When a *protected* transcode is detected and no safe fallback is found:
#   True  => exit non-zero to prevent the transcode from starting (strict compliance)
#   False => fall back to passing through to the real transcoder
KILL_TRANSCODE_IF_NO_FALLBACK: bool = True

# When we cannot even determine whether the input is protected (API/search failure):
#   True  => fail closed for streaming transcodes (maximum compliance)
#   False => pass through (minimum disruption)
KILL_TRANSCODE_IF_UNSURE: bool = True


# --- 7) Performance tuning / argument rewriting --------------------------------------

# Optional: rewrite HDR->SDR tone mapping filters when we swapped to an SDR source.
#
# Why this exists:
#   Plex builds a filter graph for the *original* (HDR) input. If we swap to SDR, the tonemap filters become wasted CPU and can even make SDR look wrong.
#
# Implementation detail:
#   We replace tone mapping filters (tonemap/libplacebo/procamp and some zscale variants) with "null" so the graph structure stays valid.
STRIP_HDR_TONEMAP_FILTERS: bool = True

# Optional: remove bitrate caps (-maxrate/-bufsize/-b) from the encoder args.
# This can speed up some encoders by reducing rate-control overhead, but it can also increase bandwidth / output size. Off by default.
REMOVE_BITRATE_LIMITS: bool = False


# --- 8) Stream safety checks ----------------------------------------------------------

# When True, only swap to a fallback file that appears to have *at least* the input stream indexes referenced by the transcoder command line (e.g. if args reference 0:1, ensure fallback has stream index 1).
#
# This reduces the risk of "stream map" failures when versions have different audio/sub layouts.
REQUIRE_STREAM_INDEX_COMPATIBILITY: bool = True


# --- 9) Caching (optional) ------------------------------------------------------------

# Cache successful lookups on disk to avoid repeated Plex API calls.
ENABLE_CACHE: bool = True

# Where to store the cache.
CACHE_FILE: str = "/config/downshiftarr_plex_transcoder_cache.json"

# Cache time-to-live.
CACHE_TTL_S: int = 60 * 60  # 1 hour


# --- 10) Decision budget and sanitized telemetry --------------------------------------

# Keep the shim from making Plex clients wait. When this budget is exhausted,
# pass through to the real transcoder rather than performing more Plex lookups.
DECISION_BUDGET_MS: int = 100

TELEMETRY_ENABLED: bool = True
TELEMETRY_FILE: str = "/var/lib/downshiftarr/cache/plex-transcoder-telemetry.json"

# Shadow mode records would-be swaps and immediately passes through to Plex.
SHADOW_MODE: bool = False

_ACTIVE_DECISION_START_MS: Optional[float] = None


# --- 10) Misc ------------------------------------------------------------------------

# Video file extensions used to identify the primary "-i <file>" input.
VIDEO_EXTENSIONS: Tuple[str, ...] = (
    ".mkv", ".mp4", ".m4v", ".avi", ".mov", ".wmv",
    ".ts", ".flv", ".webm", ".3gp", ".mpeg", ".mpg",
)


# --- 11) External config -------------------------------------------------------------

# Optional JSON config path. Bragi uses this so the installed shim binary can stay
# immutable while policy values live under /etc/downshiftarr.
SHIM_CONFIG_ENV_VAR: str = "DOWNSHIFTARR_SHIM_CONFIG"

_CONFIG_SCHEMA: Dict[str, type] = {
    "REAL_TRANSCODER_PATH": str,
    "REAL_TRANSCODER_SUFFIX": str,
    "LOG_FILE": str,
    "LOG_LEVEL": str,
    "PLEX_URL": str,
    "PLEX_TOKEN_FILE": str,
    "PLEX_HTTP_TIMEOUT_S": float,
    "PLEX_SEARCH_LIMIT_PER_HUB": int,
    "ENABLE_SECTION_SCAN_FALLBACK": bool,
    "SECTION_SCAN_MAX_ITEMS": int,
    "VERSION_INDEX_FILE": str,
    "VERSION_INDEX_MAX_AGE_S": int,
    "ONLY_INTERCEPT_STREAMING_TRANSCODES": bool,
    "SKIP_WHEN_VIDEO_CODEC_COPY": bool,
    "MAX_ALLOWED_HEIGHT": int,
    "MAX_FALLBACK_HEIGHT": int,
    "PREFER_HEIGHTS": tuple,
    "FALLBACK_SDR_ONLY": bool,
    "ALLOW_HDR_FALLBACK": bool,
    "TREAT_TONEMAP_ARGS_AS_HDR": bool,
    "FAST_PATH_SKIP_FULL_METADATA_IF_UNPROTECTED": bool,
    "AUTO_WATERFALL_ON_CONTINUED_TRANSCODE": bool,
    "WATERFALL_MIN_HEIGHT": int,
    "KILL_TRANSCODE_IF_NO_FALLBACK": bool,
    "KILL_TRANSCODE_IF_UNSURE": bool,
    "STRIP_HDR_TONEMAP_FILTERS": bool,
    "REMOVE_BITRATE_LIMITS": bool,
    "REQUIRE_STREAM_INDEX_COMPATIBILITY": bool,
    "ENABLE_CACHE": bool,
    "CACHE_FILE": str,
    "CACHE_TTL_S": int,
    "DECISION_BUDGET_MS": int,
    "TELEMETRY_ENABLED": bool,
    "TELEMETRY_FILE": str,
    "SHADOW_MODE": bool,
}


def _coerce_config_value(key: str, value: object) -> object:
    expected = _CONFIG_SCHEMA[key]
    if expected is bool:
        if not isinstance(value, bool):
            raise RuntimeError(f"Shim config key {key} must be boolean")
        return value
    if expected is int:
        if isinstance(value, bool) or not isinstance(value, int):
            raise RuntimeError(f"Shim config key {key} must be integer")
        return value
    if expected is float:
        if isinstance(value, bool) or not isinstance(value, (int, float)):
            raise RuntimeError(f"Shim config key {key} must be numeric")
        return float(value)
    if expected is tuple:
        if not isinstance(value, list) or any(isinstance(v, bool) or not isinstance(v, int) for v in value):
            raise RuntimeError(f"Shim config key {key} must be a list of integers")
        return tuple(value)
    if expected is str:
        if not isinstance(value, str):
            raise RuntimeError(f"Shim config key {key} must be string")
        if key == "REAL_TRANSCODER_SUFFIX" and not value:
            raise RuntimeError("Shim config key REAL_TRANSCODER_SUFFIX must not be empty")
        return value
    raise RuntimeError(f"Unsupported shim config schema type for {key}")


def _reject_unsafe_parent_dirs(config_path: str) -> None:
    parent = os.path.abspath(os.path.dirname(config_path) or ".")
    while True:
        if os.path.islink(parent):
            raise RuntimeError("Shim config parent directory must not be a symlink")
        st = os.stat(parent)
        world_writable = bool(st.st_mode & stat.S_IWOTH)
        group_writable = bool(st.st_mode & stat.S_IWGRP)
        sticky_root_dir = bool(st.st_mode & stat.S_ISVTX) and st.st_uid == 0
        if (world_writable or group_writable) and not sticky_root_dir:
            raise RuntimeError("Shim config parent directory is writable by group or other")
        next_parent = os.path.dirname(parent)
        if next_parent == parent:
            break
        parent = next_parent


def _open_external_config(config_path: str):
    def opener(path: str, flags: int):
        return os.open(path, flags | getattr(os, "O_NOFOLLOW", 0))

    return open(config_path, "r", encoding="utf-8", opener=opener)


def _open_no_follow_text(path: str):
    def opener(open_path: str, flags: int):
        return os.open(open_path, flags | getattr(os, "O_NOFOLLOW", 0))

    return open(path, "r", encoding="utf-8", opener=opener)


def _validate_external_config_file(config_path: str, handle) -> None:
    st = os.fstat(handle.fileno())
    if not stat.S_ISREG(st.st_mode):
        raise RuntimeError("Shim config file must be a regular file")
    if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise RuntimeError("Shim config file must not be writable by group or other")
    if st.st_uid not in {0, os.getuid()}:
        raise RuntimeError("Shim config file must be owned by root or the Plex service user")


def _read_plex_token_file(token_path: str) -> str:
    token_path = (token_path or "").strip()
    if not token_path:
        return ""
    if not os.path.isabs(token_path):
        raise RuntimeError("Plex token file path must be absolute")
    _reject_unsafe_parent_dirs(token_path)
    if not os.path.isfile(token_path):
        raise RuntimeError("Plex token file is missing")
    if os.path.islink(token_path):
        raise RuntimeError("Plex token file must not be a symlink")

    try:
        with _open_no_follow_text(token_path) as handle:
            st = os.fstat(handle.fileno())
            if not stat.S_ISREG(st.st_mode):
                raise RuntimeError("Plex token file must be a regular file")
            if st.st_mode & (stat.S_IWGRP | stat.S_IWOTH | stat.S_IROTH):
                raise RuntimeError("Plex token file permissions are too open")
            if st.st_uid not in {0, os.getuid()}:
                raise RuntimeError("Plex token file must be owned by root or the Plex service user")
            if st.st_size > 8192:
                raise RuntimeError("Plex token file is unexpectedly large")
            token = handle.readline().strip()
    except OSError as exc:
        raise RuntimeError(f"Plex token file could not be opened safely: {exc}") from exc

    if not token:
        raise RuntimeError("Plex token file is empty")
    return token


def _load_external_config() -> None:
    config_path = os.environ.get(SHIM_CONFIG_ENV_VAR, "").strip()
    if not config_path:
        return
    if not os.path.isabs(config_path):
        raise RuntimeError("Shim config file path must be absolute")
    _reject_unsafe_parent_dirs(config_path)
    if not os.path.isfile(config_path):
        raise RuntimeError(f"Shim config file is missing: {config_path}")
    if os.path.islink(config_path):
        raise RuntimeError("Shim config file must not be a symlink")

    try:
        with _open_external_config(config_path) as handle:
            _validate_external_config_file(config_path, handle)
            data = json.load(handle)
    except OSError as exc:
        raise RuntimeError(f"Shim config file could not be opened safely: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"Shim config file is not valid JSON: {exc}") from exc

    if not isinstance(data, dict):
        raise RuntimeError("Shim config file must contain a JSON object")

    for key, value in data.items():
        if key not in _CONFIG_SCHEMA:
            raise RuntimeError(f"Unsupported shim config key: {key}")
        globals()[key] = _coerce_config_value(key, value)


_load_external_config()


