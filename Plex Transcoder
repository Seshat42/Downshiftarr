# Helpers: Plex HTTP
# =====================================================================================


def effective_plex_token() -> str:
    """Return the configured token, token-file token, or best-effort env token."""
    if PLEX_TOKEN_FILE.strip():
        try:
            return _read_plex_token_file(PLEX_TOKEN_FILE)
        except RuntimeError as exc:
            log("ERROR", f"Plex token file rejected: {exc}")
            return ""
    if PLEX_TOKEN.strip():
        return PLEX_TOKEN.strip()
    for env_key in PLEX_TOKEN_ENV_VARS:
        v = (os.environ.get(env_key) or "").strip()
        if v:
            return v
    return ""


def _join_url(base: str, path: str) -> str:
    base = (base or "").rstrip("/")
    path = (path or "").strip()
    if not path.startswith("/"):
        path = "/" + path
    return base + path


def plex_get_json(path: str, params: Dict[str, str]) -> Optional[dict]:
    """GET a Plex endpoint and parse JSON.

    Returns a dict on success, or None on error.
    """
    token = effective_plex_token()
    if not token:
        log("ERROR", "PLEX_TOKEN is not configured and no X_PLEX_TOKEN env var was found.")
        return None
    remaining_budget_s = remaining_decision_budget_s()
    if remaining_budget_s is not None and remaining_budget_s <= 0:
        log("DEBUG", f"Decision budget exhausted before Plex API request path={path}")
        return None
    timeout_s = PLEX_HTTP_TIMEOUT_S
    if remaining_budget_s is not None:
        timeout_s = min(PLEX_HTTP_TIMEOUT_S, max(remaining_budget_s, 0.001))

    q = dict(params or {})
    url = _join_url(PLEX_URL, path)
    if q:
        url = url + ("?" + urllib.parse.urlencode(q))

    req = urllib.request.Request(
        url,
        headers={"Accept": "application/json", "X-Plex-Token": token},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_s) as resp:
            raw = resp.read()
        return json.loads(raw.decode("utf-8", errors="replace"))
    except Exception as e:
        log("DEBUG", f"Plex API error path={path} err={e}")
        return None


